  <!-- Standalone Client-Side P2P Application Logic (Zero Firebase, Zero Auth, Zero Backend) -->
  <script>
    (function () {
      // --- 1. CONSTANTS & STATE ---
      const AVATAR_GRADIENTS = [
        'from-indigo-500 to-purple-600',
        'from-emerald-500 to-teal-600',
        'from-rose-500 to-pink-600',
        'from-amber-500 to-orange-600',
        'from-cyan-500 to-blue-600',
        'from-fuchsia-500 to-purple-600'
      ];

      const ADJECTIVES = ['Swift', 'Neon', 'Cyber', 'Silent', 'Shadow', 'Cosmic', 'Velvet', 'Lunar', 'Solar', 'Phantom'];
      const NOUNS = ['Falcon', 'Panda', 'Fox', 'Wolf', 'Lynx', 'Raven', 'Orbit', 'Spark', 'Viper', 'Hawk'];
      const EMOJIS = ['😀', '😂', '🥰', '😎', '🤔', '🙌', '👏', '🔥', '❤️', '💯', '🎉', '🚀', '👀', '✨', '👍', '🤝', '💡', '🛡️', '🎧', '📹', '👋', '🥳', '🤩', '🫡'];

      const state = {
        localId: 'usr-' + Math.random().toString(36).substring(2, 10),
        displayName: '',
        avatarColor: AVATAR_GRADIENTS[0],
        roomId: '',
        isHost: false,
        inRoom: false,
        echoBotActive: false,
        // Transport channels
        bc: null, // BroadcastChannel for same-browser multi-tab instant connection
        peer: null, // PeerJS instance for cross-device WebRTC P2P
        dataConns: new Map(), // peerId -> DataConnection
        mediaConns: new Map(), // peerId -> MediaConnection
        peers: new Map(), // peerId -> { id, displayName, avatarColor, inCall, callType, transport }
        // Call state
        inCall: false,
        callType: 'video', // 'voice' | 'video'
        micEnabled: true,
        camEnabled: true,
        screenSharing: false,
        localStream: null,
        screenStream: null,
        remoteStream: null,
        incomingMediaCall: null,
        incomingCallerMeta: null,
        callTimerInterval: null,
        callSeconds: 0,
        typingTimeout: null,
        lastTypingSent: 0
      };

      // --- 2. DOM REFERENCES ---
      const els = {
        lobbyView: document.getElementById('lobby-view'),
        roomView: document.getElementById('room-view'),
        tabCreate: document.getElementById('tab-create'),
        tabJoin: document.getElementById('tab-join'),
        submitBtnLabel: document.getElementById('submit-btn-label'),
        roomEntryForm: document.getElementById('room-entry-form'),
        displayNameInput: document.getElementById('display-name-input'),
        lobbyAvatarPreview: document.getElementById('lobby-avatar-preview'),
        colorSwatches: document.getElementById('color-swatches'),
        randomizeNameBtn: document.getElementById('randomize-name-btn'),
        roomIdInput: document.getElementById('room-id-input'),
        generateRoomBtn: document.getElementById('generate-room-btn'),
        copyLobbyCodeBtn: document.getElementById('copy-lobby-code-btn'),
        copyLobbyLinkBtn: document.getElementById('copy-lobby-link-btn'),
        roomHintText: document.getElementById('room-hint-text'),
        // Room Header
        activeRoomTitle: document.getElementById('active-room-title'),
        activeUserAlias: document.getElementById('active-user-alias'),
        connectionStatusPill: document.getElementById('connection-status-pill'),
        connectionStatusDot: document.getElementById('connection-status-dot'),
        connectionStatusText: document.getElementById('connection-status-text'),
        bannerRoomCode: document.getElementById('banner-room-code'),
        sidebarRoomCode: document.getElementById('sidebar-room-code'),
        messagesContainer: document.getElementById('messages-container'),
        typingIndicatorBar: document.getElementById('typing-indicator-bar'),
        typingUserName: document.getElementById('typing-user-name'),
        chatForm: document.getElementById('chat-form'),
        messageInput: document.getElementById('message-input'),
        emojiToggleBtn: document.getElementById('emoji-toggle-btn'),
        emojiPickerPopover: document.getElementById('emoji-picker-popover'),
        closeEmojiBtn: document.getElementById('close-emoji-btn'),
        emojiGrid: document.getElementById('emoji-grid'),
        participantsSidebar: document.getElementById('participants-sidebar'),
        toggleParticipantsBtn: document.getElementById('toggle-participants-btn'),
        closeSidebarMobile: document.getElementById('close-sidebar-mobile'),
        participantsList: document.getElementById('participants-list'),
        participantCountBadge: document.getElementById('participant-count-badge'),
        sidebarOnlineSubtitle: document.getElementById('sidebar-online-subtitle'),
        copyCodeHeaderBtn: document.getElementById('copy-code-header-btn'),
        copyInviteBtn: document.getElementById('copy-invite-btn'),
        bannerCopyLinkBtn: document.getElementById('banner-copy-link-btn'),
        sidebarCopyCodeBtn: document.getElementById('sidebar-copy-code-btn'),
        sidebarCopyBtn: document.getElementById('sidebar-copy-btn'),
        toggleEchoBotBtn: document.getElementById('toggle-echo-bot-btn'),
        echoBotBtnLabel: document.getElementById('echo-bot-btn-label'),
        sidebarEchoBtn: document.getElementById('sidebar-echo-btn'),
        sidebarEchoLabel: document.getElementById('sidebar-echo-label'),
        leaveRoomBtn: document.getElementById('leave-room-btn'),
        // Call UI
        callStage: document.getElementById('call-stage'),
        callModeLabel: document.getElementById('call-mode-label'),
        callTimer: document.getElementById('call-timer'),
        headerVoiceCallBtn: document.getElementById('header-voice-call-btn'),
