        screenShareBadge: document.getElementById('screen-share-badge'),
        remoteVideo: document.getElementById('remote-video'),
        remoteParticipantsVisual: document.getElementById('remote-participants-visual'),
        remoteAvatarsCluster: document.getElementById('remote-avatars-cluster'),
        remoteStageStatus: document.getElementById('remote-stage-status'),
        remoteTileBadge: document.getElementById('remote-tile-badge'),
        toggleMicBtn: document.getElementById('toggle-mic-btn'),
        toggleCamBtn: document.getElementById('toggle-cam-btn'),
        toggleScreenBtn: document.getElementById('toggle-screen-btn'),
        endCallBtn: document.getElementById('end-call-btn'),
        // Incoming Call Modal
        incomingCallModal: document.getElementById('incoming-call-modal'),
        incomingCallerAvatar: document.getElementById('incoming-caller-avatar'),
        incomingCallerName: document.getElementById('incoming-caller-name'),
        incomingCallTypeText: document.getElementById('incoming-call-type-text'),
        acceptCallBtn: document.getElementById('accept-call-btn'),
        declineCallBtn: document.getElementById('decline-call-btn')
      };

      // --- 3. UTILITY FUNCTIONS ---
      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        const colors = {
          info: 'bg-slate-900 dark:bg-slate-800 text-white border-slate-700',
          success: 'bg-emerald-600 text-white border-emerald-500',
          warning: 'bg-amber-600 text-white border-amber-500',
          error: 'bg-rose-600 text-white border-rose-500'
        };
        toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl border shadow-lg text-xs font-medium flex items-center gap-2 transition-all duration-300 transform translate-y-0 opacity-100 ${colors[type] || colors.info}`;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => {
          toast.classList.add('opacity-0', '-translate-y-2');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      function generateRandomAlias() {
        const adj = ADJECTIVES[Math.floor(Math.random() * ADJECTIVES.length)];
        const noun = NOUNS[Math.floor(Math.random() * NOUNS.length)];
        return `${adj}${noun}`;
      }

      function generateRoomCode() {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        let code = '';
        for (let i = 0; i < 6; i++) {
          code += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return `ANON-${code}`;
      }

      function sanitizeRoomId(raw) {
        const cleaned = raw.trim().toUpperCase().replace(/[^A-Z0-9-]/g, '').slice(0, 16);
        return cleaned;
      }

      function getInviteUrl(roomId) {
        const url = new URL(window.location.href);
        url.searchParams.set('room', roomId);
        return url.toString();
      }

      function copyTextToClipboard(text, successMsg = 'Copied to clipboard!') {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          showToast(successMsg, 'success');
        } catch (err) {
          showToast('Unable to copy text', 'error');
        }
        document.body.removeChild(textarea);
      }

      function getInitials(name) {
        return (name || '?').slice(0, 2).toUpperCase();
      }

      function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      function formatMessageWithLinks(text) {
        const escaped = escapeHtml(text);
        const urlRegex = /(https?:\/\/[^\s<]+)/g;
        return escaped.replace(
          urlRegex,
          '<a href="$1" target="_blank" rel="noopener noreferrer" class="underline font-medium hover:opacity-80 break-all">$1</a>'
        );
      }

      // --- 4. THEME HANDLING ---
      function toggleTheme() {
        document.documentElement.classList.toggle('dark');
        lucide.createIcons();
      }
      document.getElementById('theme-toggle-lobby').addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-room').addEventListener('click', toggleTheme);

      // --- 5. LOBBY INITIALIZATION & ONBOARDING ---
      function updateLobbyAvatarPreview() {
        const name = els.displayNameInput.value.trim() || 'SF';
        els.lobbyAvatarPreview.textContent = getInitials(name);
        els.lobbyAvatarPreview.className = `w-11 h-11 rounded-xl bg-gradient-to-br ${state.avatarColor} flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-sm`;
      }

      function renderColorSwatches() {
        els.colorSwatches.innerHTML = '';
        AVATAR_GRADIENTS.forEach((grad) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `w-6 h-6 rounded-full bg-gradient-to-br ${grad} transition transform hover:scale-110 ${
            state.avatarColor === grad ? 'ring-2 ring-offset-2 ring-brand-500 dark:ring-offset-slate-900 scale-110' : 'opacity-75 hover:opacity-100'
          }`;
          btn.addEventListener('click', () => {
            state.avatarColor = grad;
            renderColorSwatches();
            updateLobbyAvatarPreview();
          });
          els.colorSwatches.appendChild(btn);
        });
      }

      function switchLobbyTab(mode) {
        if (mode === 'create') {
          els.tabCreate.className = 'py-2.5 text-sm font-semibold rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm transition';
          els.tabJoin.className = 'py-2.5 text-sm font-semibold rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition';
          els.submitBtnLabel.textContent = 'Create & Enter Room';
          els.roomHintText.textContent = 'Create a room and share the code or link—no sign-in required.';
          if (!els.roomIdInput.value) els.roomIdInput.value = generateRoomCode();
        } else {
          els.tabJoin.className = 'py-2.5 text-sm font-semibold rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm transition';
          els.tabCreate.className = 'py-2.5 text-sm font-semibold rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition';
          els.submitBtnLabel.textContent = 'Join Private Room';
          els.roomHintText.textContent = 'Enter a 6-character Room Code shared with you to connect immediately.';
        }
      }

      function initLobby() {
        els.displayNameInput.value = generateRandomAlias();
        state.avatarColor = AVATAR_GRADIENTS[Math.floor(Math.random() * AVATAR_GRADIENTS.length)];
        renderColorSwatches();
        updateLobbyAvatarPreview();

        const params = new URLSearchParams(window.location.search);
        const urlRoom = params.get('room');
        if (urlRoom) {
          els.roomIdInput.value = sanitizeRoomId(urlRoom);
          switchLobbyTab('join');
        } else {
          els.roomIdInput.value = generateRoomCode();
          switchLobbyTab('create');
        }
      }

      els.displayNameInput.addEventListener('input', updateLobbyAvatarPreview);
      els.tabCreate.addEventListener('click', () => switchLobbyTab('create'));
      els.tabJoin.addEventListener('click', () => switchLobbyTab('join'));
      els.randomizeNameBtn.addEventListener('click', () => {
        els.displayNameInput.value = generateRandomAlias();
        updateLobbyAvatarPreview();
      });
      els.generateRoomBtn.addEventListener('click', () => {
        els.roomIdInput.value = generateRoomCode();
      });
      els.copyLobbyCodeBtn.addEventListener('click', () => {
        const code = sanitizeRoomId(els.roomIdInput.value) || generateRoomCode();
        els.roomIdInput.value = code;
        copyTextToClipboard(code, `Room code ${code} copied!`);
      });
      els.copyLobbyLinkBtn.addEventListener('click', () => {
        const code = sanitizeRoomId(els.roomIdInput.value) || generateRoomCode();
        els.roomIdInput.value = code;
        copyTextToClipboard(getInviteUrl(code), `Invite link for ${code} copied!`);
      });

      // --- 6. DUAL P2P TRANSPORT LAYER (BroadcastChannel + PeerJS WebRTC) ---
      function broadcastPacket(packet) {
        // 1. Send via BroadcastChannel (instant same-browser multi-tab support, works even offline)
        if (state.bc) {
          try {
            state.bc.postMessage(packet);
          } catch (e) {}
        }
        // 2. Send via all active PeerJS WebRTC DataConnections (cross-device over internet)
        state.dataConns.forEach((conn) => {
          if (conn && conn.open) {
            try {
              conn.send(packet);
            } catch (e) {}
          }
        });
      }

      function handleIncomingPacket(packet, sourceTransport = 'p2p') {
        if (!packet || !packet.type || packet.senderId === state.localId) return;

        switch (packet.type) {
          case 'HELLO': {
            const isNewPeer = !state.peers.has(packet.senderId);
            state.peers.set(packet.senderId, {
              id: packet.senderId,
              displayName: packet.displayName,
              avatarColor: packet.avatarColor,
              inCall: !!packet.inCall,
              callType: packet.callType || 'video',
              transport: sourceTransport
            });
            updateConnectionUI();
            renderParticipantsSidebar();
            updateRemoteCallStage();

            if (isNewPeer) {
              appendSystemMessage(`${packet.displayName} connected to room`);
              // Reply with our own HELLO so both sides sync immediately
              broadcastPacket({
                type: 'HELLO',
                senderId: state.localId,
                displayName: state.displayName,
                avatarColor: state.avatarColor,
                inCall: state.inCall,
                callType: state.callType
              });
            }
            break;
          }

          case 'PRESENCE_UPDATE': {
            if (state.peers.has(packet.senderId)) {
              const existing = state.peers.get(packet.senderId);
              existing.inCall = !!packet.inCall;
              existing.callType = packet.callType || 'video';
              state.peers.set(packet.senderId, existing);
              renderParticipantsSidebar();
              updateRemoteCallStage();
            }
            break;
          }

          case 'BYE': {
            if (state.peers.has(packet.senderId)) {
              const peerInfo = state.peers.get(packet.senderId);
              state.peers.delete(packet.senderId);
              appendSystemMessage(`${peerInfo.displayName} left the room`);
              updateConnectionUI();
              renderParticipantsSidebar();
              updateRemoteCallStage();
            }
            break;
          }

          case 'CHAT': {
            hideTypingIndicator();
            appendChatMessage({
              senderId: packet.senderId,
              senderName: packet.senderName,
              avatarColor: packet.avatarColor,
              text: packet.text,
              createdAt: packet.createdAt || Date.now()
            });
            break;
          }

          case 'TYPING': {
            showTypingIndicator(packet.senderName);
            break;
          }

          case 'CALL_SIGNAL': {
            if (packet.action === 'ring' && !state.inCall) {
              state.incomingCallerMeta = {
                senderId: packet.senderId,
                senderName: packet.senderName,
                avatarColor: packet.avatarColor,
                callType: packet.callType || 'video'
              };
              showIncomingCallBanner(state.incomingCallerMeta);
            } else if (packet.action === 'decline') {
              showToast(`${packet.senderName} declined the call`, 'info');
            } else if (packet.action === 'end') {
              appendSystemMessage(`${packet.senderName} ended the call`);
              clearRemoteMediaDisplay();
            }
            break;
          }
        }
      }

      function setupBroadcastChannel(roomCode) {
        if (state.bc) {
          state.bc.close();
        }
        try {
          state.bc = new BroadcastChannel(`anonlink_room_${roomCode}`);
          state.bc.onmessage = (event) => {
            handleIncomingPacket(event.data, 'local-tab');
          };
          // Announce presence to any other open tabs in this room
          broadcastPacket({
            type: 'HELLO',
            senderId: state.localId,
            displayName: state.displayName,
            avatarColor: state.avatarColor,
            inCall: state.inCall,
            callType: state.callType
          });
        } catch (err) {
          console.warn('BroadcastChannel unavailable:', err);
        }
      }

      function setupPeerJS(roomCode) {
        if (typeof Peer === 'undefined') {
          updateConnectionUI();
          return;
        }

        // Clean room code to valid PeerJS ID format
        const cleanRoom = roomCode.replace(/[^A-Z0-9]/g, '');
        const hostPeerId = `anonlink-v1-${cleanRoom}-host`;

        // Try registering as the room host ID first; if taken, join as a guest peer and connect to host
        const peerInstance = new Peer(hostPeerId, { debug: 0 });
        state.peer = peerInstance;

        peerInstance.on('open', () => {
          state.isHost = true;
          updateConnectionUI();
        });

        peerInstance.on('connection', (conn) => {
          wireDataConnection(conn);
        });

        peerInstance.on('call', (mediaCall) => {
          handleIncomingWebRTCMediaCall(mediaCall);
        });

        peerInstance.on('error', (err) => {
          if (err.type === 'unavailable-id') {
            // Host ID already exists -> connect as guest peer to host!
            peerInstance.destroy();
            connectAsGuestPeer(hostPeerId);
          } else {
            // Fallback gracefully to BroadcastChannel / local mode without showing scary errors
            updateConnectionUI();
          }
        });
      }

      function connectAsGuestPeer(hostPeerId) {
        if (typeof Peer === 'undefined') return;
        const guestPeer = new Peer(undefined, { debug: 0 });
        state.peer = guestPeer;
        state.isHost = false;

        guestPeer.on('open', () => {
          const conn = guestPeer.connect(hostPeerId, { reliable: true });
          wireDataConnection(conn);
          updateConnectionUI();
        });

        guestPeer.on('connection', (conn) => {
          wireDataConnection(conn);
        });

        guestPeer.on('call', (mediaCall) => {
          handleIncomingWebRTCMediaCall(mediaCall);
        });

        guestPeer.on('error', () => {
          updateConnectionUI();
        });
      }

      function wireDataConnection(conn) {
        conn.on('open', () => {
          state.dataConns.set(conn.peer, conn);
          conn.send({
            type: 'HELLO',
            senderId: state.localId,
            displayName: state.displayName,
            avatarColor: state.avatarColor,
            inCall: state.inCall,
            callType: state.callType
          });
          updateConnectionUI();
        });

        conn.on('data', (data) => {
          handleIncomingPacket(data, 'webrtc-p2p');
        });

        conn.on('close', () => {
          state.dataConns.delete(conn.peer);
          updateConnectionUI();
        });
      }

      function updateConnectionUI() {
        const peerCount = state.peers.size + (state.echoBotActive ? 1 : 0);
        if (peerCount > 0) {
          els.connectionStatusPill.className = 'inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
          els.connectionStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500';
          els.connectionStatusText.textContent = 'Connected P2P';
        } else {
          els.connectionStatusPill.className = 'inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400';
          els.connectionStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse';
          els.connectionStatusText.textContent = 'Waiting for peer...';
        }
      }

      // --- 7. ENTERING & LEAVING ROOMS ---
      function enterRoom(e) {
        e.preventDefault();
        const alias = els.displayNameInput.value.trim() || generateRandomAlias();
        const roomCode = sanitizeRoomId(els.roomIdInput.value) || generateRoomCode();
        const joinMode = document.querySelector('input[name="joinMode"]:checked')?.value || 'chat';

        state.displayName = alias;
        state.roomId = roomCode;
        state.inRoom = true;
        state.peers.clear();
        state.dataConns.clear();
        state.mediaConns.clear();

        // Update URL query param cleanly without reload
        try {
          const url = new URL(window.location.href);
          url.searchParams.set('room', roomCode);
          window.history.replaceState({}, '', url);
        } catch (err) {}

        // Update Room UI labels
        els.activeRoomTitle.textContent = roomCode;
        els.activeUserAlias.textContent = alias;
        els.bannerRoomCode.textContent = roomCode;
        els.sidebarRoomCode.textContent = roomCode;
        els.localCallAvatar.textContent = getInitials(alias);
        els.localCallAvatar.className = `w-16 h-16 rounded-full bg-gradient-to-br ${state.avatarColor} flex items-center justify-center text-white text-xl font-bold shadow-lg relative z-10`;
        els.localCallName.textContent = alias;
        els.localTileLabel.textContent = `${alias} (You)`;

        // Reset messages area keeping privacy banner
        const banner = els.messagesContainer.firstElementChild;
        els.messagesContainer.innerHTML = '';
        if (banner) els.messagesContainer.appendChild(banner);

        // Switch screens
        els.lobbyView.classList.add('hidden');
        els.roomView.classList.remove('hidden');
        lucide.createIcons();

        // Initialize P2P & Tab channels
        setupBroadcastChannel(roomCode);
        setupPeerJS(roomCode);
        renderParticipantsSidebar();
        updateConnectionUI();

        if (joinMode === 'call') {
          startCall('video');
        }
      }

      function leaveRoom() {
        if (state.inCall) {
          stopCall(false);
        }

        broadcastPacket({
          type: 'BYE',
          senderId: state.localId,
          displayName: state.displayName
        });

        if (state.bc) {
          state.bc.close();
          state.bc = null;
        }
        if (state.peer) {
          state.peer.destroy();
          state.peer = null;
        }

        state.peers.clear();
        state.dataConns.clear();
        state.mediaConns.clear();
        state.inRoom = false;
        state.echoBotActive = false;
        updateEchoBotLabels();

        try {
          const url = new URL(window.location.href);
          url.searchParams.delete('room');
          window.history.replaceState({}, '', url);
        } catch (err) {}

        els.roomView.classList.add('hidden');
        els.lobbyView.classList.remove('hidden');
        els.roomIdInput.value = generateRoomCode();
        showToast('Left private room', 'info');
      }

      els.roomEntryForm.addEventListener('submit', enterRoom);
      els.leaveRoomBtn.addEventListener('click', leaveRoom);
      window.addEventListener('beforeunload', () => {
        if (state.inRoom) {
          broadcastPacket({ type: 'BYE', senderId: state.localId, displayName: state.displayName });
        }
      });

      // --- 8. CHAT MESSAGING, TYPING INDICATOR & ECHO BOT ---
