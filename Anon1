```html
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AnonLink — Standalone Numberless Chat & Calls</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- PeerJS for Zero-Backend Direct WebRTC P2P Connections -->
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    };
  </script>

  <style>
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.3);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.5);
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      70% { transform: scale(1.25); opacity: 0; }
      100% { transform: scale(0.95); opacity: 0; }
    }
    .animate-pulse-ring {
      animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    .typing-dot {
      animation: typingBounce 1.4s infinite ease-in-out both;
    }
    .typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @keyframes typingBounce {
      0%, 80%, 100% { transform: scale(0); }
      40% { transform: scale(1); }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 antialiased selection:bg-brand-500 selection:text-white transition-colors duration-200 overflow-hidden h-screen flex flex-col">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- INCOMING CALL MODAL BANNER -->
  <div id="incoming-call-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 max-w-sm w-full shadow-2xl text-center space-y-5">
      <div class="relative mx-auto w-20 h-20 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-emerald-500/30 animate-pulse-ring"></div>
        <div id="incoming-caller-avatar" class="w-16 h-16 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white text-xl font-bold shadow-lg relative z-10">
          ?
        </div>
      </div>
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
          Incoming Encrypted Call
        </span>
        <h3 id="incoming-caller-name" class="text-lg font-bold mt-2">Peer</h3>
        <p id="incoming-call-type-text" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">is inviting you to a video call...</p>
      </div>
      <div class="grid grid-cols-2 gap-3 pt-1">
        <button id="decline-call-btn" type="button" class="py-3 px-4 rounded-2xl bg-rose-500/10 hover:bg-rose-500 text-rose-600 hover:text-white font-semibold text-xs flex items-center justify-center gap-2 transition">
          <i data-lucide="phone-off" class="w-4 h-4"></i>
          <span>Decline</span>
        </button>
        <button id="accept-call-btn" type="button" class="py-3 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-lg shadow-emerald-600/25 flex items-center justify-center gap-2 transition">
          <i data-lucide="phone-call" class="w-4 h-4"></i>
          <span>Accept</span>
        </button>
      </div>
    </div>
  </div>

  <!-- LOBBY VIEW (100% Standalone, Zero Login, No Phone Number) -->
  <main id="lobby-view" class="flex-1 flex flex-col justify-between overflow-y-auto p-4 sm:p-8">
    <!-- Top Navbar -->
    <header class="max-w-6xl w-full mx-auto flex items-center justify-between py-2">
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-brand-500/25">
          <i data-lucide="shield-check" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="font-bold text-xl tracking-tight">AnonLink</span>
          <span class="ml-2 text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">No Login • No Number</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full bg-slate-200/70 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-slate-600 dark:text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>100% Client-Side P2P Ready</span>
        </div>
        <button id="theme-toggle-lobby" aria-label="Toggle theme" class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition shadow-sm">
          <i data-lucide="sun" class="w-5 h-5 hidden dark:block text-amber-400"></i>
          <i data-lucide="moon" class="w-5 h-5 block dark:hidden text-slate-700"></i>
        </button>
      </div>
    </header>

    <!-- Center Hero & Room Card -->
    <section class="max-w-5xl w-full mx-auto my-auto py-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Info Column -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-600 dark:text-brand-400 text-xs font-medium">
          <i data-lucide="lock" class="w-3.5 h-3.5"></i>
          <span>Zero-Account • Direct WebRTC P2P • Works Anywhere</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
          Chat & Call Freely.<br />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-500 via-indigo-400 to-purple-500">Zero Phone Numbers.</span>
        </h1>

        <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Open directly in any browser with zero sign-ups, zero logins, and no server storage. Create a 6-character Room Code and share your link to connect peer-to-peer for instant messaging, voice calls, and HD video.
        </p>

        <div class="grid grid-cols-3 gap-3 pt-2 max-w-md mx-auto lg:mx-0">
          <div class="p-3 rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200/80 dark:border-slate-800/80 text-center">
            <i data-lucide="user-x" class="w-5 h-5 mx-auto mb-1 text-brand-500"></i>
            <p class="text-xs font-semibold">No Login / SIM</p>
          </div>
          <div class="p-3 rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200/80 dark:border-slate-800/80 text-center">
            <i data-lucide="video" class="w-5 h-5 mx-auto mb-1 text-purple-500"></i>
            <p class="text-xs font-semibold">P2P Video & Voice</p>
          </div>
          <div class="p-3 rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200/80 dark:border-slate-800/80 text-center">
            <i data-lucide="zap" class="w-5 h-5 mx-auto mb-1 text-emerald-500"></i>
            <p class="text-xs font-semibold">Instant Link</p>
          </div>
        </div>
      </div>

      <!-- Right Action Card -->
      <div class="lg:col-span-6">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl shadow-slate-200/50 dark:shadow-black/40">
          <!-- Mode Tabs -->
          <div class="grid grid-cols-2 p-1 rounded-2xl bg-slate-100 dark:bg-slate-950 border border-slate-200/70 dark:border-slate-800 mb-6">
            <button id="tab-create" type="button" class="py-2.5 text-sm font-semibold rounded-xl bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm transition">
              Create New Room
            </button>
            <button id="tab-join" type="button" class="py-2.5 text-sm font-semibold rounded-xl text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition">
              Join Existing Room
            </button>
          </div>

          <form id="room-entry-form" class="space-y-5">
            <!-- Display Alias & Avatar Color -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="display-name-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Your Temporary Handle
                </label>
                <button type="button" id="randomize-name-btn" class="text-xs text-brand-600 dark:text-brand-400 hover:underline flex items-center gap-1 font-medium">
                  <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Randomize
                </button>
              </div>
              <div class="flex items-center gap-2.5">
                <div id="lobby-avatar-preview" class="w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm shrink-0 shadow-sm">
                  SF
                </div>
                <div class="relative flex-1">
                  <i data-lucide="at-sign" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                  <input
                    id="display-name-input"
                    type="text"
                    maxlength="24"
                    required
                    placeholder="e.g., SwiftFalcon, NeonPanda"
                    class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm font-medium"
                  />
                </div>
              </div>
              <!-- Quick Avatar Color Swatches -->
              <div class="flex items-center gap-2 mt-2.5">
                <span class="text-[11px] text-slate-500 dark:text-slate-400 mr-1">Badge Color:</span>
                <div id="color-swatches" class="flex items-center gap-1.5"></div>
              </div>
            </div>

            <!-- Room Code Section -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="room-id-input" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                  Room Code
                </label>
                <button type="button" id="generate-room-btn" class="text-xs text-brand-600 dark:text-brand-400 hover:underline flex items-center gap-1 font-medium">
                  <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> New Code
                </button>
              </div>
              <div class="relative flex items-center gap-2">
                <div class="relative flex-1">
                  <i data-lucide="hash" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                  <input
                    id="room-id-input"
                    type="text"
                    maxlength="16"
                    required
                    placeholder="ANON-XXXXXX"
                    class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-500 font-mono text-sm uppercase tracking-wider"
                  />
                </div>
                <button type="button" id="copy-lobby-code-btn" title="Copy Room Code" class="p-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 transition">
                  <i data-lucide="copy" class="w-5 h-5"></i>
                </button>
                <button type="button" id="copy-lobby-link-btn" title="Copy Invite Link" class="p-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 transition">
                  <i data-lucide="link" class="w-5 h-5"></i>
                </button>
              </div>
              <p id="room-hint-text" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
                Create a room and share the code or link—no sign-in required.
              </p>
            </div>

            <!-- Join Mode Selection -->
            <div class="pt-1">
              <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                Start With
              </span>
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="joinMode" value="chat" checked class="peer sr-only" />
                  <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 peer-checked:border-brand-500 peer-checked:bg-brand-500/10 flex items-center justify-center gap-2 text-sm font-medium transition">
                    <i data-lucide="message-square" class="w-4 h-4 text-brand-500"></i>
                    <span>Text Chat</span>
                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="joinMode" value="call" class="peer sr-only" />
                  <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 peer-checked:border-brand-500 peer-checked:bg-brand-500/10 flex items-center justify-center gap-2 text-sm font-medium transition">
                    <i data-lucide="video" class="w-4 h-4 text-purple-500"></i>
                    <span>Chat + Video Call</span>
                  </div>
                </label>
              </div>
            </div>

            <button
              type="submit"
              id="enter-room-submit-btn"
              class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 hover:from-brand-500 hover:to-purple-500 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2 transition transform active:scale-[0.99]"
            >
              <span id="submit-btn-label">Create & Enter Room</span>
              <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="max-w-6xl w-full mx-auto py-2 text-center text-xs text-slate-500 dark:text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-2">
      <span>100% Standalone Browser App • No Accounts • No Phone Numbers • No Servers</span>
      <span class="font-mono text-[11px] opacity-75">WebRTC P2P + Local Tab Sync</span>
    </footer>
  </main>

  <!-- ACTIVE ROOM VIEW -->
  <div id="room-view" class="hidden flex-1 flex flex-col h-screen overflow-hidden">
    <!-- Room Top Bar -->
    <header class="h-16 px-3 sm:px-6 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between shrink-0 z-20">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center text-white shrink-0">
          <i data-lucide="shield" class="w-5 h-5"></i>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h2 id="active-room-title" class="font-mono font-bold text-sm sm:text-base tracking-wide truncate">ANON-XXXXXX</h2>
            <span id="connection-status-pill" class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400">
              <span id="connection-status-dot" class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
              <span id="connection-status-text">Waiting for peer...</span>
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 truncate">
            You: <span id="active-user-alias" class="font-semibold text-slate-700 dark:text-slate-200">User</span> • Zero-Number P2P
          </p>
        </div>
      </div>

      <!-- Room Header Actions -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Start Voice Call -->
        <button id="header-voice-call-btn" title="Start Voice Call" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-emerald-500/15 hover:text-emerald-600 dark:hover:text-emerald-400 text-slate-700 dark:text-slate-200 transition flex items-center gap-1.5 text-xs font-semibold">
          <i data-lucide="phone" class="w-4 h-4"></i>
          <span class="hidden md:inline">Voice Call</span>
        </button>

        <!-- Start Video Call -->
        <button id="header-video-call-btn" title="Start Video Call" class="p-2.5 rounded-xl bg-brand-500/10 hover:bg-brand-500/20 text-brand-600 dark:text-brand-400 transition flex items-center gap-1.5 text-xs font-semibold">
          <i data-lucide="video" class="w-4 h-4"></i>
          <span class="hidden md:inline">Video Call</span>
        </button>

        <!-- Copy Code -->
        <button id="copy-code-header-btn" title="Copy Room Code" class="hidden sm:flex p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition items-center gap-1.5 text-xs font-semibold">
          <i data-lucide="hash" class="w-4 h-4"></i>
          <span class="hidden xl:inline">Code</span>
        </button>

        <!-- Copy Invite Link -->
        <button id="copy-invite-btn" title="Copy Shareable Invite Link" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition flex items-center gap-1.5 text-xs font-semibold">
          <i data-lucide="share-2" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Invite Link</span>
        </button>

        <!-- Participants Drawer Toggle -->
        <button id="toggle-participants-btn" title="Room Info & Peers" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition flex items-center gap-1.5 text-xs font-semibold">
          <i data-lucide="users" class="w-4 h-4"></i>
          <span id="participant-count-badge" class="px-1.5 py-0.2 rounded-full bg-brand-600 text-white text-[10px]">1</span>
        </button>

        <!-- Theme Toggle -->
        <button id="theme-toggle-room" aria-label="Toggle theme" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
          <i data-lucide="sun" class="w-4 h-4 hidden dark:block text-amber-400"></i>
          <i data-lucide="moon" class="w-4 h-4 block dark:hidden text-slate-700"></i>
        </button>

        <!-- Leave Room -->
        <button id="leave-room-btn" title="Leave Room" class="p-2.5 rounded-xl bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-600 dark:text-rose-400 transition flex items-center gap-1.5 text-xs font-semibold">
          <i data-lucide="log-out" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Leave</span>
        </button>
      </div>
    </header>

    <!-- Main Workspace Area -->
    <div class="flex-1 flex overflow-hidden relative">
      <!-- Left/Center Area: Call Stage + Chat Feed -->
      <div class="flex-1 flex flex-col min-w-0 bg-slate-50 dark:bg-slate-950">

        <!-- COLLAPSIBLE VOICE / VIDEO CALL STAGE -->
        <section id="call-stage" class="hidden bg-slate-900 border-b border-slate-800 p-3 sm:p-4 shrink-0 transition-all">
          <div class="max-w-5xl mx-auto flex flex-col gap-3">
            <!-- Call Top Info Bar -->
            <div class="flex items-center justify-between text-xs text-slate-300">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="call-mode-label" class="font-semibold text-white">Direct P2P WebRTC Call</span>
                <span id="call-timer" class="font-mono text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md">00:00</span>
              </div>
              <span id="media-permission-note" class="text-[11px] text-slate-400 hidden sm:inline">Encrypted peer-to-peer media stream</span>
            </div>

            <!-- Video / Avatar Grid -->
            <div id="video-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[44vh] min-h-[195px]">
              <!-- Local User Tile -->
              <div class="relative rounded-2xl bg-slate-800 border border-slate-700/80 overflow-hidden flex items-center justify-center aspect-video sm:aspect-auto sm:h-56 shadow-inner">
                <video id="local-video" autoplay muted playsinline class="w-full h-full object-cover hidden"></video>
                <div id="local-avatar-placeholder" class="flex flex-col items-center justify-center gap-2 p-4">
                  <div class="relative">
                    <div id="local-speaking-ring" class="absolute inset-0 rounded-full bg-brand-500/40 animate-pulse-ring hidden"></div>
                    <div id="local-call-avatar" class="w-16 h-16 rounded-full bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center text-white text-xl font-bold shadow-lg relative z-10">
                      U
                    </div>
                  </div>
                  <span id="local-call-name" class="text-xs font-semibold text-slate-200">You</span>
                </div>

                <!-- Tile Overlay Badges -->
                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none">
                  <span class="px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md text-white text-[11px] font-medium flex items-center gap-1.5">
                    <span id="local-tile-label">You</span>
                    <span id="screen-share-badge" class="hidden px-1.5 py-0.2 rounded bg-amber-500 text-black font-bold text-[9px] uppercase">Screen</span>
                  </span>
                  <span id="local-mic-indicator" class="p-1.5 rounded-lg bg-black/60 backdrop-blur-md text-emerald-400">
                    <i data-lucide="mic" class="w-3.5 h-3.5"></i>
                  </span>
                </div>
              </div>

              <!-- Remote Peer Tile -->
