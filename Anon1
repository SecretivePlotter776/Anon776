      // --- 10. VOICE & VIDEO CALLING ENGINE (WebRTC MediaConnection) ---
      async function startCall(mode = 'video', isAnswering = false) {
        state.inCall = true;
        state.callType = mode;
        state.micEnabled = true;
        state.camEnabled = mode === 'video';

        els.callStage.classList.remove('hidden');
        els.callModeLabel.textContent = mode === 'video' ? 'Direct P2P Video & Voice Call' : 'Direct P2P Voice Call';

        try {
          if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            const stream = await navigator.mediaDevices.getUserMedia({
              audio: true,
              video: mode === 'video'
            });
            state.localStream = stream;
            if (mode === 'video') {
              els.localVideo.srcObject = stream;
              els.localVideo.classList.remove('hidden');
              els.localAvatarPlaceholder.classList.add('hidden');
            } else {
              els.localVideo.classList.add('hidden');
              els.localAvatarPlaceholder.classList.remove('hidden');
              els.localSpeakingRing.classList.remove('hidden');
            }
          }
        } catch (err) {
          state.camEnabled = false;
          els.localVideo.classList.add('hidden');
          els.localAvatarPlaceholder.classList.remove('hidden');
          els.localSpeakingRing.classList.remove('hidden');
          showToast('Camera/Mic hardware unavailable — using simulated call stage', 'info');
        }

        // Initiate WebRTC MediaConnection to any connected PeerJS peers
        if (state.peer && state.localStream) {
          state.dataConns.forEach((conn, peerId) => {
            if (!state.mediaConns.has(peerId)) {
              try {
                const call = state.peer.call(peerId, state.localStream, {
                  metadata: {
                    senderName: state.displayName,
                    avatarColor: state.avatarColor,
                    callType: mode
                  }
                });
                wireMediaConnection(call);
              } catch (e) {}
            }
          });
        }

        // Notify peers over DataChannel / BroadcastChannel
        broadcastPacket({
          type: 'PRESENCE_UPDATE',
          senderId: state.localId,
          inCall: true,
          callType: mode
        });

        if (!isAnswering) {
          broadcastPacket({
            type: 'CALL_SIGNAL',
            action: 'ring',
            senderId: state.localId,
            senderName: state.displayName,
            avatarColor: state.avatarColor,
            callType: mode
          });
          appendSystemMessage(`${state.displayName} started a ${mode} call`);
        }

        updateCallControlButtons();
        startCallTimer();
        renderParticipantsSidebar();
        updateRemoteCallStage();
      }

      function handleIncomingWebRTCMediaCall(mediaCall) {
        if (state.inCall && state.localStream) {
          mediaCall.answer(state.localStream);
          wireMediaConnection(mediaCall);
          return;
        }
        state.incomingMediaCall = mediaCall;
        const meta = mediaCall.metadata || {};
        showIncomingCallBanner({
          senderName: meta.senderName || 'Remote Peer',
          avatarColor: meta.avatarColor || 'from-emerald-500 to-teal-600',
          callType: meta.callType || 'video'
        });
      }

      function wireMediaConnection(mediaCall) {
        state.mediaConns.set(mediaCall.peer, mediaCall);
        mediaCall.on('stream', (remoteStream) => {
          state.remoteStream = remoteStream;
          els.remoteVideo.srcObject = remoteStream;
          els.remoteVideo.classList.remove('hidden');
          els.remoteParticipantsVisual.classList.add('hidden');
          els.remoteTileBadge.classList.remove('hidden');
          const peerName = mediaCall.metadata?.senderName || 'Remote Peer';
          els.remoteTileBadge.textContent = peerName;
        });

        mediaCall.on('close', () => {
          state.mediaConns.delete(mediaCall.peer);
          clearRemoteMediaDisplay();
        });
      }

      function clearRemoteMediaDisplay() {
        state.remoteStream = null;
        els.remoteVideo.srcObject = null;
        els.remoteVideo.classList.add('hidden');
        els.remoteParticipantsVisual.classList.remove('hidden');
        els.remoteTileBadge.classList.add('hidden');
        updateRemoteCallStage();
      }

      function showIncomingCallBanner(meta) {
        els.incomingCallerAvatar.textContent = getInitials(meta.senderName);
        els.incomingCallerAvatar.className = `w-16 h-16 rounded-full bg-gradient-to-br ${meta.avatarColor || 'from-emerald-500 to-teal-600'} flex items-center justify-center text-white text-xl font-bold shadow-lg relative z-10`;
        els.incomingCallerName.textContent = meta.senderName;
        els.incomingCallTypeText.textContent = `is inviting you to a ${meta.callType === 'voice' ? 'voice' : 'video'} call...`;
        els.incomingCallModal.classList.remove('hidden');
        lucide.createIcons();
      }

      els.acceptCallBtn.addEventListener('click', async () => {
        els.incomingCallModal.classList.add('hidden');
        const mode = state.incomingCallerMeta?.callType || state.incomingMediaCall?.metadata?.callType || 'video';
        await startCall(mode, true);
        if (state.incomingMediaCall) {
          state.incomingMediaCall.answer(state.localStream || undefined);
          wireMediaConnection(state.incomingMediaCall);
          state.incomingMediaCall = null;
        }
      });

      els.declineCallBtn.addEventListener('click', () => {
        els.incomingCallModal.classList.add('hidden');
        if (state.incomingMediaCall) {
          state.incomingMediaCall.close();
          state.incomingMediaCall = null;
        }
        broadcastPacket({
          type: 'CALL_SIGNAL',
          action: 'decline',
          senderId: state.localId,
          senderName: state.displayName
        });
      });

      function stopCall(notify = true) {
        state.inCall = false;
        state.screenSharing = false;
        clearInterval(state.callTimerInterval);
        state.callSeconds = 0;
        els.callTimer.textContent = '00:00';

        state.mediaConns.forEach((mc) => mc.close());
        state.mediaConns.clear();

        if (state.localStream) {
          state.localStream.getTracks().forEach((t) => t.stop());
          state.localStream = null;
        }
        if (state.screenStream) {
          state.screenStream.getTracks().forEach((t) => t.stop());
          state.screenStream = null;
        }

        els.localVideo.srcObject = null;
        els.localVideo.classList.add('hidden');
        els.localAvatarPlaceholder.classList.remove('hidden');
        els.localSpeakingRing.classList.add('hidden');
        els.screenShareBadge.classList.add('hidden');
        clearRemoteMediaDisplay();
        els.callStage.classList.add('hidden');

        if (notify && state.inRoom) {
          broadcastPacket({
            type: 'PRESENCE_UPDATE',
            senderId: state.localId,
            inCall: false,
            callType: 'video'
          });
          broadcastPacket({
            type: 'CALL_SIGNAL',
            action: 'end',
            senderId: state.localId,
            senderName: state.displayName
          });
          appendSystemMessage(`${state.displayName} ended the call`);
          renderParticipantsSidebar();
        }
      }

      function startCallTimer() {
        clearInterval(state.callTimerInterval);
        state.callSeconds = 0;
        state.callTimerInterval = setInterval(() => {
          state.callSeconds++;
          const mins = String(Math.floor(state.callSeconds / 60)).padStart(2, '0');
          const secs = String(state.callSeconds % 60).padStart(2, '0');
          els.callTimer.textContent = `${mins}:${secs}`;
        }, 1000);
      }

      function updateCallControlButtons() {
        els.toggleMicBtn.innerHTML = state.micEnabled
          ? `<i data-lucide="mic" class="w-4 h-4 text-emerald-400"></i><span class="hidden sm:inline">Mic On</span>`
          : `<i data-lucide="mic-off" class="w-4 h-4 text-rose-400"></i><span class="hidden sm:inline">Muted</span>`;

        els.localMicIndicator.innerHTML = state.micEnabled
          ? `<i data-lucide="mic" class="w-3.5 h-3.5 text-emerald-400"></i>`
          : `<i data-lucide="mic-off" class="w-3.5 h-3.5 text-rose-400"></i>`;

        els.toggleCamBtn.innerHTML = state.camEnabled
          ? `<i data-lucide="video" class="w-4 h-4 text-brand-400"></i><span class="hidden sm:inline">Cam On</span>`
          : `<i data-lucide="video-off" class="w-4 h-4 text-slate-400"></i><span class="hidden sm:inline">Cam Off</span>`;

        els.toggleScreenBtn.className = state.screenSharing
          ? 'p-3 rounded-2xl bg-amber-500/20 text-amber-300 border border-amber-500/50 transition flex items-center gap-2 text-xs font-medium'
          : 'p-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 transition flex items-center gap-2 text-xs font-medium';

        lucide.createIcons();
      }

      function updateRemoteCallStage() {
        const peersInCall = [];
        state.peers.forEach((p) => {
          if (p.inCall) peersInCall.push(p);
        });
        if (state.echoBotActive && state.inCall) {
          peersInCall.push({
            displayName: 'EchoBot (Demo)',
            avatarColor: 'from-emerald-500 to-teal-600'
          });
        }

        if (peersInCall.length === 0) {
          els.remoteAvatarsCluster.innerHTML = `
            <div class="w-14 h-14 rounded-full bg-slate-700 border-2 border-slate-800 flex items-center justify-center text-slate-300">
              <i data-lucide="radio" class="w-6 h-6 animate-pulse text-brand-400"></i>
            </div>
          `;
          els.remoteStageStatus.textContent = 'Waiting for peer media stream...';
        } else {
          els.remoteAvatarsCluster.innerHTML = peersInCall
            .map(
              (p) => `
              <div class="w-14 h-14 rounded-full bg-gradient-to-br ${p.avatarColor || 'from-brand-500 to-purple-600'} border-2 border-slate-900 flex items-center justify-center text-white font-bold text-sm shadow-lg" title="${escapeHtml(p.displayName)}">
                ${escapeHtml(getInitials(p.displayName))}
              </div>
            `
            )
            .join('');
          const names = peersInCall.map((p) => p.displayName).join(', ');
          els.remoteStageStatus.textContent = `Connected with ${names}`;
        }
        lucide.createIcons();
      }

      els.headerVoiceCallBtn.addEventListener('click', () => startCall('voice'));
      els.headerVideoCallBtn.addEventListener('click', () => startCall('video'));
      els.endCallBtn.addEventListener('click', () => stopCall(true));

      els.toggleMicBtn.addEventListener('click', () => {
        state.micEnabled = !state.micEnabled;
        if (state.localStream) {
          state.localStream.getAudioTracks().forEach((track) => (track.enabled = state.micEnabled));
        }
        updateCallControlButtons();
      });

      els.toggleCamBtn.addEventListener('click', async () => {
        state.camEnabled = !state.camEnabled;
        if (state.camEnabled) {
          try {
            if (!state.localStream || state.localStream.getVideoTracks().length === 0) {
              const vidStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: state.micEnabled });
              state.localStream = vidStream;
            }
            state.localStream.getVideoTracks().forEach((t) => (t.enabled = true));
            els.localVideo.srcObject = state.localStream;
            els.localVideo.classList.remove('hidden');
            els.localAvatarPlaceholder.classList.add('hidden');
          } catch (err) {
            state.camEnabled = false;
            showToast('Camera permission not available', 'warning');
          }
        } else {
          if (state.localStream) {
            state.localStream.getVideoTracks().forEach((t) => (t.enabled = false));
          }
          els.localVideo.classList.add('hidden');
          els.localAvatarPlaceholder.classList.remove('hidden');
        }
        updateCallControlButtons();
      });

      els.toggleScreenBtn.addEventListener('click', async () => {
        if (state.screenSharing) {
          if (state.screenStream) {
            state.screenStream.getTracks().forEach((t) => t.stop());
            state.screenStream = null;
          }
          state.screenSharing = false;
          els.screenShareBadge.classList.add('hidden');
          if (state.camEnabled && state.localStream) {
            els.localVideo.srcObject = state.localStream;
          } else {
            els.localVideo.classList.add('hidden');
            els.localAvatarPlaceholder.classList.remove('hidden');
          }
          updateCallControlButtons();
          return;
        }

        try {
          if (navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia) {
            const displayStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
            state.screenStream = displayStream;
            state.screenSharing = true;
            els.localVideo.srcObject = displayStream;
            els.localVideo.classList.remove('hidden');
            els.localAvatarPlaceholder.classList.add('hidden');
            els.screenShareBadge.classList.remove('hidden');

            displayStream.getVideoTracks()[0].onended = () => {
              state.screenSharing = false;
              els.screenShareBadge.classList.add('hidden');
              els.localVideo.classList.add('hidden');
              els.localAvatarPlaceholder.classList.remove('hidden');
              updateCallControlButtons();
            };
            updateCallControlButtons();
          } else {
            showToast('Screen sharing is not supported in this browser view', 'warning');
          }
        } catch (err) {
          showToast('Screen share cancelled or blocked by browser permissions', 'info');
        }
      });

      // --- 11. BOOTSTRAP ---
      lucide.createIcons();
      initLobby();
    })();
  </script>
</body>
</html>
