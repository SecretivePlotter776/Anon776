      // Copy Code & Invite Link Handlers
      const copyRoomCode = () => copyTextToClipboard(state.roomId, `Room code ${state.roomId} copied!`);
      const copyRoomInvite = () => copyTextToClipboard(getInviteUrl(state.roomId), 'Shareable invite link copied!');

      els.copyCodeHeaderBtn.addEventListener('click', copyRoomCode);
      els.sidebarCopyCodeBtn.addEventListener('click', copyRoomCode);
