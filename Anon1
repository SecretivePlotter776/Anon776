      function handleSendMessage(e) {
        e.preventDefault();
        const text = els.messageInput.value.trim();
        if (!text) return;

        els.messageInput.value = '';
        els.emojiPickerPopover.classList.add('hidden');

        const msgPayload = {
          type: 'CHAT',
          senderId: state.localId,
          senderName: state.displayName,
          avatarColor: state.avatarColor,
          text,
          createdAt: Date.now()
        };

        appendChatMessage(msgPayload);
        broadcastPacket(msgPayload);

        // If Echo Bot solo test mode is active, simulate a realistic P2P reply
        if (state.echoBotActive) {
          showTypingIndicator('EchoBot');
          setTimeout(() => {
            hideTypingIndicator();
            const replies = [
              `Echo: "${text}" — P2P DataChannel verified!`,
              `Received "${text}" with zero phone number or login required.`,
              `Loud and clear! Try testing Voice Call or Video Call above too.`
            ];
            const replyText = replies[Math.floor(Math.random() * replies.length)];
            appendChatMessage({
              senderId: 'echo-bot',
              senderName: 'EchoBot (Demo)',
              avatarColor: 'from-emerald-500 to-teal-600',
              text: replyText,
              createdAt: Date.now()
