        const wrapper = document.createElement('div');
        wrapper.className = `flex items-end gap-2.5 max-w-2xl ${isMe ? 'ml-auto flex-row-reverse' : 'mr-auto'}`;

        const grad = avatarColor || 'from-brand-500 to-purple-600';
        const initials = getInitials(senderName);

        wrapper.innerHTML = `
          <div class="w-8 h-8 rounded-full bg-gradient-to-br ${grad} flex items-center justify-center text-white text-xs font-bold shrink-0 shadow-sm">
